{
  "name": "@s2j/similarity-client",
  "version": "1.0.0",
  "description": "TypeScript SDK (@s2j/similarity-client): stable HTTP wrapper for the S2J Similarity OpenAPI contract; generated clients are not part of the public API",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vitest": "^3.2.4"
  }
}
