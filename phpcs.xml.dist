<?xml version="1.0"?>
<ruleset name="s2j-similarity-service">
    <description>
        PHP_CodeSniffer — PSR-12 + project conventions (docs/engineering/ci.md)。
        生成 DTO は OpenAPI codegen の成果物のため対象外。
        tests は WorDBless / WP_REST_Server やスタブの都合で PSR-1 の一部のみ緩和。
    </description>

    <rule ref="PSR12"/>

    <!-- Match composer.json & CI (PHP 8.0+). -->
    <config name="php_version" value="80000"/>

    <file>src</file>
    <file>adapters</file>
    <file>tests</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/wordpress/*</exclude-pattern>
    <exclude-pattern>src/Contracts/DTO/Generated/</exclude-pattern>

    <!-- PHPUnit ブートストラップ: require と定義の順序が目的 -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>

    <!-- 既存テストはグローバル namespace・複数クラス1ファイル・WP 互換メソッド名を許容 -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
</ruleset>
