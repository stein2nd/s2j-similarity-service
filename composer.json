{
    "name": "s2j/similarity-service",
    "description": "A pure PHP library for semantic similarity detection.",
    "version": "2.0.3",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "autoload": {
      "psr-4": {
        "S2J\\SimilarityService\\": "src/",
        "S2J\\Similarity\\": "src/",
        "S2J\\Similarity\\Adapters\\": "adapters/",
        "S2J\\Similarity\\Adapters\\Http\\WordPress\\": "adapters/http/wordpress/"
      }
    },
    "autoload-dev": {
      "psr-4": {
        "S2J\\Similarity\\Tests\\Support\\": "tests/Support/"
      }
    },
    "require": {
      "php": ">=8.0"
    },
    "require-dev": {
        "automattic/wordbless": "^0.6",
        "johnpbloch/wordpress": "^6.9",
        "phpunit/phpunit": "^13.1",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0",
        "justinrainbow/json-schema": "^6",
        "symfony/yaml": "^6.4"
    },
    "config": {
        "allow-plugins": {
            "roots/wordpress-core-installer": true
        }
    },
    "extra": {
        "wordpress-install-dir": "wordpress"
    },
    "archive": {
        "name": "s2j-similarity-service",
        "exclude": [
            "/node_modules",
            "/vendor",
            "/wordpress",
            "/tests",
            "/docs",
            "/docs_old",
            "/.github",
            "/.vscode",
            "/.cursor",
            "/packages",
            "/scripts",
            "/schema",
            "/tools",
            "/examples",
            "/artifacts",
            "/dist",
            "/tmp",
            "/.sandbox",
            ".phpunit.cache",
            ".phpunit.result.cache",
            "phpunit.xml",
            "phpunit.xml.bak",
            "phpcs.xml.dist",
            "phpstan.neon",
            "openapitools.json",
            "package.json",
            "package-lock.json",
            ".textlintrc.json",
            "composer.lock",
            ".DS_Store",
            ".gitignore",
            "src/Interfaces",
            "src/types"
        ]
    },
    "scripts": {
        "dist:php": "./scripts/package/php-archive.zsh",
        "test": "@php vendor/bin/phpunit",
        "test:unit": "@php vendor/bin/phpunit --testsuite unit",
        "test:wordpress": "@php vendor/bin/phpunit --testsuite wordpress",
        "phpstan": "@php vendor/bin/phpstan analyse --memory-limit=512M",
        "phpcs": "@php vendor/bin/phpcs",
        "phpcbf": "@php vendor/bin/phpcbf",
        "lint:php": [
            "@phpstan",
            "@phpcs"
        ],
        "post-install-cmd": "WorDBless\\Composer\\InstallDropin::copy",
        "post-update-cmd": "WorDBless\\Composer\\InstallDropin::copy"
    }
}
