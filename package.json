{
  "name": "s2j-similarity-service",
  "version": "2.0.0",
  "description": "A pure PHP library for semantic similarity detection",
  "type": "module",
  "author": "Koutarou ISHIKAWA",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stein2nd/s2j-similarity-service.git"
  },
  "homepage": "https://github.com/stein2nd/s2j-similarity-service#readme",
  "bugs": {
    "url": "https://github.com/stein2nd/s2j-similarity-service/issues"
  },
  "keywords": [
    "php",
    "library",
    "semantic",
    "similarity"
  ],
  "workspaces": [
    "packages/*"
  ],
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "files": [
    "README.md",
    "COMMON_SPEC.md",
    "LICENSE"
  ],
  "main": "src/SimilarityService.php",
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.37.0",
    "@s2j/docs-linter": "^1.0.18",
    "openapi-typescript": "^7.13.0",
    "openapi-typescript-codegen": "^0.30.0",
    "openapi-zod-client": "^1.18.3"
  },
  "scripts": {
    "generate": "./scripts/generate/all.zsh",
    "verify:codegen": "./scripts/generate/all.zsh && git diff --exit-code",
    "build:ts-client": "npm run build -w @s2j/similarity-client",
    "test:ts-client": "npm test -w @s2j/similarity-client",
    "lint:docs": "s2j-docs-linter ./README.md ./CHANGELOG.md ./docs/**/*.md"
  }
}
